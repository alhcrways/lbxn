{
  "name": "shinchan-pet",
  "version": "1.0.8",
  "description": "蜡笔小新桌宠：支持聊天与多便利贴的 Windows 桌面宠物",
  "main": "dist-electron/main.cjs",
  "author": "shinchan-pet",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "wait-on http://[::1]:5173/ && npm run build:main && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 node scripts/launch.mjs",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\"",
    "build:main": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:main && vite build",
    "start": "npm run build:main && vite build && node scripts/launch.mjs",
    "dist": "npm run build && electron-builder --win nsis portable",
    "dist:portable": "npm run build && electron-builder --win portable",
    "social:build": "esbuild src/social/server-entry.ts --bundle --platform=node --format=cjs --outfile=dist-social/server.cjs",
    "social:server": "npm run social:build && node dist-social/server.cjs",
    "test:social": "node scripts/test-social.mjs",
    "test:social:ui": "npm run build:main && node scripts/check-social-ui.mjs",
    "start:alice": "cross-env SHINCHAN_PROFILE=alice node scripts/launch.mjs",
    "start:bob": "cross-env SHINCHAN_PROFILE=bob node scripts/launch.mjs",
    "test:reminder": "node scripts/check-break-reminder.cjs && node scripts/check-walking.cjs",
    "test:logging": "node scripts/check-logging.cjs",
    "test:packaged-menu": "node scripts/check-packaged-menu.mjs",
    "test:portable": "node scripts/check-portable.cjs"
  },
  "devDependencies": {
    "@tabler/icons-react": "^3.24.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.24.2",
    "playwright-core": "1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "comments": {
    "packaging": "npm run dist:portable 生成免安装单文件版本；npm run dist 同时生成安装版和便携版。",
    "portableIsolation": "electron-builder 26.15.3 的实现中 unpackDirName: true 才会使用每次启动独立的 $PLUGINSDIR/app（与选项文档的 false 相反）。固定构建器版本并通过真实 EXE 重复启动测试，避免第二个启动器清理正在运行的资源。"
  },
  "build": {
    "appId": "com.shinchan.pet",
    "productName": "蜡笔小新桌宠",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/**",
      "!assets/walking/**",
      "!assets/note-mascots.png"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Shinchan-Pet-${version}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "unpackDirName": true,
      "artifactName": "Shinchan-Pet-${version}-Portable.${ext}"
    }
  }
}
