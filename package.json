{
  "name": "shinchan-pet",
  "version": "1.0.3",
  "description": "蜡笔小新桌宠：支持聊天与多便利贴的 Windows 桌面宠物",
  "main": "dist-electron/main.cjs",
  "author": "shinchan-pet",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "wait-on http://[::1]:5173/ && npm run build:main && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 node scripts/launch.mjs",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\"",
    "build:main": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:main && vite build",
    "start": "npm run build:main && vite build && node scripts/launch.mjs",
    "dist": "npm run build && electron-builder --win nsis portable",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "devDependencies": {
    "@tabler/icons-react": "^3.24.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "comments": {
    "packaging": "npm run dist:portable 生成免安装单文件版本；npm run dist 同时生成安装版和便携版。"
  },
  "build": {
    "appId": "com.shinchan.pet",
    "productName": "蜡笔小新桌宠",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/**"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Shinchan-Pet-${version}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Shinchan-Pet-${version}-Portable.${ext}"
    }
  }
}
